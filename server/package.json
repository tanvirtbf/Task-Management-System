{
    "name": "task-management-system-server",
    "version": "1.0.0",
    "description": "Task Management System backend API",
    "main": "index.js",
    "scripts": {
        "dev": "cross-env NODE_ENV=dev nodemon src/server.ts",
        "format:check": "prettier . --check",
        "format:fix": "prettier . --write",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "jest --watch --runInBand",
        "build": "tsc",
        "start": "node dist/server.js",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "ts-node --transpile-only src/db/migrate.ts",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio"
    },
    "author": "Tanvir Ahmed",
    "license": "ISC",
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.17",
        "@types/http-errors": "^2.0.1",
        "@types/jest": "^29.5.4",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^25.0.3",
        "@types/supertest": "^2.0.12",
        "@typescript-eslint/eslint-plugin": "^6.6.0",
        "@typescript-eslint/parser": "^6.6.0",
        "cross-env": "^7.0.3",
        "drizzle-kit": "^0.31.8",
        "eslint": "^8.48.0",
        "eslint-config-prettier": "^9.0.0",
        "jest": "^29.6.4",
        "nodemon": "^3.0.1",
        "prettier": "3.0.3",
        "supertest": "^6.3.3",
        "ts-jest": "^29.1.1",
        "ts-node": "^10.9.2",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.6.1",
        "drizzle-orm": "^0.45.1",
        "express": "^4.18.2",
        "express-jwt": "^8.5.1",
        "express-rate-limit": "^8.2.1",
        "express-validator": "^7.3.1",
        "http-errors": "^2.0.0",
        "jsonwebtoken": "^9.0.3",
        "mysql2": "^3.16.0",
        "winston": "^3.10.0"
    }
}
