{
    "name": "task-management-server",
    "version": "1.0.0",
    "description": "Internal task management system — Express + MySQL + Drizzle",
    "main": "dist/server.js",
    "scripts": {
        "dev": "cross-env NODE_ENV=dev nodemon src/server.ts",
        "build": "tsc",
        "start": "cross-env NODE_ENV=prod node dist/server.js",
        "format:check": "prettier . --check",
        "format:fix": "prettier . --write",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "jest --no-cache --coverage --all --runInBand --passWithNoTests",
        "test:watch": "jest --watch --runInBand",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "tsx src/db/migrate.ts",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "db:drop": "drizzle-kit drop",
        "db:setup": "tsx src/db/setup.ts",
        "db:setup:fresh": "tsx src/db/setup.ts --drop",
        "db:seed": "tsx src/db/seed.ts",
        "db:seed:demo": "tsx src/db/seed-demo.ts",
        "job": "cross-env NODE_ENV=dev tsx src/bin/run-job.ts"
    },
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@types/bcrypt": "^5.0.2",
        "@types/cookie-parser": "^1.4.7",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/http-errors": "^2.0.4",
        "@types/jest": "^29.5.12",
        "@types/jsonwebtoken": "^9.0.6",
        "@types/node": "^20.12.7",
        "@types/nodemailer": "^8.0.0",
        "@types/supertest": "^6.0.2",
        "@types/web-push": "^3.6.4",
        "@typescript-eslint/eslint-plugin": "^7.7.0",
        "@typescript-eslint/parser": "^7.7.0",
        "cross-env": "^7.0.3",
        "drizzle-kit": "^0.30.0",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "jest": "^29.7.0",
        "nodemon": "^3.1.0",
        "prettier": "^3.2.5",
        "supertest": "^7.0.0",
        "ts-jest": "^29.1.2",
        "ts-node": "^10.9.2",
        "tsx": "^4.7.2",
        "typescript": "^5.4.5"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1057.0",
        "@aws-sdk/s3-request-presigner": "^3.1057.0",
        "bcrypt": "^5.1.1",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "drizzle-orm": "^0.36.0",
        "express": "^4.19.2",
        "express-jwt": "^8.4.1",
        "express-rate-limit": "^8.5.2",
        "express-validator": "^7.0.1",
        "http-errors": "^2.0.0",
        "jsonwebtoken": "^9.0.2",
        "mysql2": "^3.10.0",
        "nodemailer": "^8.0.10",
        "openai": "^6.39.1",
        "web-push": "^3.6.7",
        "winston": "^3.13.0"
    }
}
