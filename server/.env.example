PORT=5501
NODE_ENV=dev

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=task_management
# Unix socket to MySQL. When set, this REPLACES DB_HOST/DB_PORT.
# REQUIRED on MySQL 8.4+: that release disables the mysql_native_password
# plugin, and over plain TCP mysql2 cannot finish a caching_sha2_password
# handshake — it asks for the disabled plugin and the server answers
# ER_PLUGIN_IS_NOT_LOADED. A socket is treated as a secure channel and works.
# Find yours with: mysql -N -e "SELECT @@socket;"   (Ubuntu default below)
DB_SOCKET_PATH=/var/run/mysqld/mysqld.sock

# JWT secrets — use long random strings (32+ chars). Generate via:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-string-at-least-32-chars
REFRESH_TOKEN_SECRET=change-me-to-a-different-long-random-string-32-chars

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# OpenAI — powers the in-app AI Help Assistant (server-side only; the key is
# NEVER exposed to the client). Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# Extra auth secrets — long random strings, each DIFFERENT. Generate as above.
# Token lifetimes (optional; sensible defaults apply if omitted).
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# CORS / URLs. CORS_ALLOWED_ORIGINS is a comma-separated allowlist; loopback +
# RFC-1918 LAN origins are always reflected, so this is only for extra hosts.
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:5501
CORS_ALLOWED_ORIGINS=

# Form-submission encryption (AES-256-GCM). REQUIRED for §18 forms — without it,
# form submit + the admin submissions list fail. 64 hex chars (32 bytes). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change-me-64-hex-chars-0000000000000000000000000000000000000000

# Mail / SMTP (invitations + password-reset). NOTE: dotenv is LAST-wins for
# duplicate keys — keep exactly ONE MAIL_* block or the last one silently wins.
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your-mailtrap-user
MAIL_PASSWORD=your-mailtrap-pass
MAIL_FROM_ADDRESS=no-reply@yourdomain.com
MAIL_FROM_NAME=BeautyBooth

# Cloudflare R2 (file attachments). Leave BLANK to run in local stub mode (no
# real bucket writes). Set all four for real uploads.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_URL=
# Lifetime of a presigned download URL, in seconds (optional; default 3600).
R2_SIGNED_URL_TTL=3600

# Internal cron / job runner auth — required in the X-Internal-Token header for
# every POST /api/v1/jobs/* endpoint. Long random string.
INTERNAL_JOB_TOKEN=change-me-to-a-long-random-internal-token

# Observability / tuning (optional).
LOG_LEVEL=info
DB_POOL_MAX=10
# 0 = unlimited wait queue: a burst queues (latency) instead of failing.
# A non-zero limit makes mysql2 throw "Queue limit reached" once the queue is
# full; the API maps that to 503 + Retry-After (never a 500), but latency beats
# shedding for a single-instance deployment. See ISS-087 / fixing/results/F11.md.
DB_POOL_QUEUE_LIMIT=0
# Fixed UTC offset applied to BOTH the mysql2 driver and the MySQL session, so
# THE CANONICAL CLOCK — set this to +00:00 and keep it there.
#
# MySQL stores TIMESTAMP internally as UTC; the session time_zone only controls
# how it is RENDERED. Drizzle's mysql timestamp mapper hardcodes +0000 in both
# directions, so the session MUST be UTC or every app-written timestamp is stored
# 6 hours out and every read reports 6 hours late (this was ISS-001, fixed in F3).
#
# Users still see Dhaka time: the API emits ISO-8601 and the client renders local.
# Do NOT set this to +06:00 to "make the database show Dhaka" — that reintroduces
# the bug. If you want Dhaka in a SQL client, run SET time_zone='+06:00' in that
# client's own session.
#
# Applied to BOTH the mysql2 driver option and a per-connection SET time_zone —
# see db/client.ts. Must be a fixed offset; MySQL resolves named zones only when
# the tz tables are loaded.
DB_TIMEZONE=+00:00

# ═════════════════════════════════════════════════════════════════════════════
# Optional / fallback keys that Config reads (F14 · ISS-090)
# ═════════════════════════════════════════════════════════════════════════════
# The mailer prefers the Laravel-style MAIL_* names above. These SMTP_*/EMAIL_*
# keys are the FALLBACK tier (config/index.ts: `MAIL_HOST ?? SMTP_HOST`), not a
# second configuration — leave them unset unless you are migrating from them.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=
# EMAIL_FROM_NAME=

# AI assistant reply cap. Optional — the code defaults to 800.
# OPENAI_MAX_OUTPUT_TOKENS=800
