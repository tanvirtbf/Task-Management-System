{
    "compilerOptions": {
        /* Language and Environment */
        "target": "es2022",
        "lib": ["es2022"],
        "module": "commonjs",
        "rootDir": "./",
        "outDir": "./dist",

        /* Interop Constraints */
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,

        /* Type Checking */
        "strict": true,
        "strictPropertyInitialization": false,
        "noImplicitAny": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "dist", "**/*.spec.ts", "tests"]
}
