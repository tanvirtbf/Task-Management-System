# Production build config. Vite bakes these values into the bundle at BUILD
# time — editing this file after `npm run build` changes nothing.
#
# Same-domain deployment: nginx serves this app at / and reverse-proxies
# /api/v1/* to the Node API on localhost:5501. A RELATIVE base therefore works
# on any hostname, so the production bundle is domain-independent.
#
# If the API ever moves to its own host, set the absolute form instead —
# must end in /api/v1 with NO trailing slash, or the path-scoped bb_refresh
# cookie stops matching and every reload silently signs users out:
#   VITE_BACKEND_API_URL=https://api.example.com/api/v1
VITE_BACKEND_API_URL=/api/v1
