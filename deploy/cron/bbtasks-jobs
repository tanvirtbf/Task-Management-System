# /etc/cron.d/bbtasks-jobs
#
# The seven background jobs. There is NO in-process scheduler — without this
# file nothing ever runs: sessions never expire, pending attachments and 90-day
# encrypted form PII accumulate forever, snoozed notifications never wake,
# overdue tasks never alert their assignees, and the weekly HR department
# report is never generated.
#
# Install:
#   cp deploy/cron/bbtasks-jobs /etc/cron.d/bbtasks-jobs
#   chmod 644 /etc/cron.d/bbtasks-jobs     # cron IGNORES group/other-writable files
#   chmod +x  deploy/cron/run-job.sh
#
# TIMES ARE UTC — this host runs UTC while the team works in Dhaka (UTC+6).
# Converted deliberately rather than relying on CRON_TZ, which is silently
# ignored by some cron builds and would then run everything six hours off.
#
# Verify one by hand first:
#   /var/www/html/tasks-beautybooth/deploy/cron/run-job.sh department-report --dry-run

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# Wake snoozed notifications - near-real-time.
*/5 * * * * root /var/www/html/tasks-beautybooth/deploy/cron/run-job.sh snooze-wake >>/var/log/bbtasks/cron.log 2>&1

# Alert assignees of newly-overdue tasks (email + in-app), once per task per
# deadline. Runs often so the alert lands within minutes of midnight in the
# workspace's own timezone (the moment a due_date becomes "yesterday").
*/10 * * * * root /var/www/html/tasks-beautybooth/deploy/cron/run-job.sh overdue-alert >>/var/log/bbtasks/cron.log 2>&1

# Expire dead refresh sessions.                       02:10 UTC = 08:10 Dhaka
10 2 * * * root /var/www/html/tasks-beautybooth/deploy/cron/run-job.sh session-cleanup >>/var/log/bbtasks/cron.log 2>&1

# Drop attachment rows whose upload never completed.  02:20 UTC = 08:20 Dhaka
20 2 * * * root /var/www/html/tasks-beautybooth/deploy/cron/run-job.sh attachment-janitor >>/var/log/bbtasks/cron.log 2>&1

# Delete soft-deleted objects from R2 storage.        02:30 UTC = 08:30 Dhaka
30 2 * * * root /var/www/html/tasks-beautybooth/deploy/cron/run-job.sh r2-purge >>/var/log/bbtasks/cron.log 2>&1

# Purge form submissions past their 90-day retention. 02:40 UTC = 08:40 Dhaka
40 2 * * * root /var/www/html/tasks-beautybooth/deploy/cron/run-job.sh form-submission-expiry >>/var/log/bbtasks/cron.log 2>&1

# Weekly per-department HR report + report_ready notifications.
# Monday 03:00 UTC = MONDAY 09:00 DHAKA, which is the documented schedule.
# Idempotent: safe to re-run, and a missed Monday self-heals on the next run.
0 3 * * 1 root /var/www/html/tasks-beautybooth/deploy/cron/run-job.sh department-report >>/var/log/bbtasks/cron.log 2>&1
